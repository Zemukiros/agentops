# Copy to .env. No real secrets belong in this file.
ENV=dev
LOG_LEVEL=INFO

# fake = deterministic scripted model, no API key, $0. real = Anthropic API (costs money).
LLM_MODE=fake
# fixture = recorded search results. live = real search API (Phase 3+).
SEARCH_MODE=fixture

# Real mode (LLM_MODE=real). Every role needs a real provider. Prices for these two models are
# verified in agentops/models/pricing.py (2026-11-05); real mode refuses unpriced models.
# MAX_OUTPUT_TOKENS is a hard cap per call (thinking included) and is what the budget
# ledger reserves, so keep it modest. EFFORT: low | medium | high | xhigh | max.
# ANTHROPIC_API_KEY=
# ROLE_MODELS__SUPERVISOR__PROVIDER=anthropic
# ROLE_MODELS__SUPERVISOR__MODEL=claude-sonnet-5-5
# ROLE_MODELS__SUPERVISOR__MAX_OUTPUT_TOKENS=3000
# ROLE_MODELS__SUPERVISOR__EFFORT=low
# ROLE_MODELS__REVIEWER__PROVIDER=anthropic
# ROLE_MODELS__REVIEWER__MODEL=claude-sonnet-5-5
# ROLE_MODELS__REVIEWER__MAX_OUTPUT_TOKENS=2000
# ROLE_MODELS__REVIEWER__EFFORT=low
# ROLE_MODELS__WRITING__PROVIDER=anthropic
# ROLE_MODELS__WRITING__MODEL=claude-haiku-5-5
# ROLE_MODELS__WRITING__MAX_OUTPUT_TOKENS=2000
# ROLE_MODELS__WRITING__EFFORT=low
# (research / analysis / code: same pattern; not used until Phase 3)

# Budget defaults per task
BUDGET__MAX_TOKENS=200000
BUDGET__MAX_USD=1.00
BUDGET__MAX_LLM_CALLS=60
BUDGET__MAX_STEPS_PER_SPECIALIST=8
BUDGET__RECURSION_LIMIT=60

# Database (host-side; compose services override the host to `postgres:5432`)
DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5433/agentops
TEST_DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5433/agentops_test

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`
API_TOKEN_PEPPER=
# Optional fixed seed tokens; if unset, `make migrate` generates and prints them once.
SEED_USER_TOKEN=
SEED_REVIEWER_TOKEN=

# Job queue
JOB_LEASE_SECONDS=30
JOB_HEARTBEAT_SECONDS=10

# Mailpit (captures mail; nothing leaves the machine)
SMTP_HOST=localhost
SMTP_PORT=1025

# Tracing (compose profile `observability`)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Host ports
PG_PORT=5433
API_PORT=8000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
