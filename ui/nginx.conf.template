server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # CSP: scripts/styles only from this origin; the page may talk only to the API.
    # style-src-attr 'unsafe-inline' is for React Flow's positioned nodes (style attributes,
    # not <style> or script).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Caching via `expires` (not add_header): a location with its own add_header would drop
    # every security header above (nginx does not inherit add_header into such blocks).
    location /assets/ {
        expires max;
        try_files $uri =404;
    }
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
