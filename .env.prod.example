# Production env (docker-compose.prod.yml). Copy to .env.prod (untracked) and fill in.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
API_TOKEN_PEPPER=
SQL_TOOL_PASSWORD=

# Models. LLM_MODE=real needs ANTHROPIC_API_KEY and real role models (see .env.example).
LLM_MODE=fake
ANTHROPIC_API_KEY=
SEARCH_MODE=fixture

# Browser origin(s) of the UI, comma-separated (CORS).
UI_ORIGINS=http://localhost:5173

# Email relay. Leave SMTP_HOST empty to disable send_email: proposals are then refused with
# "no SMTP relay is configured" (never silently dropped).
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=agentops@example.com
